// ============================================================
// EduBridge Network — Prisma Schema
// PostgreSQL. Designed for 200,000+ users.
// All tables, PKs, FKs, indexes, composite indexes, enums.
// ============================================================

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; the linux-musl-openssl-3.0.x target is required
  // for the node:20-alpine production image (Alpine ships OpenSSL 3).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum AuthProvider {
  EMAIL
  GOOGLE
  PHONE
}

enum CollegeVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum SignupIntent {
  COLLEGE_ADMISSIONS
  INTERNSHIPS_JOBS
}

enum ReviewCategory {
  PLACEMENT
  HOSTEL
  FACULTY
  CAMPUS_LIFE
  ROI
}

enum ResourceType {
  NOTES
  PDF
  ROADMAP
  PLACEMENT_REPORT
  STUDY_MATERIAL
}

enum TransferStatus {
  EXPLORING
  ELIGIBLE
  APPLIED
  COMPLETED
}

enum NotificationType {
  LIKE
  COMMENT
  MENTION
  MESSAGE
  FOLLOW
  SCHOLARSHIP
  INTERNSHIP_DEADLINE
  TRANSFER_UPDATE
  BADGE_EARNED
  SYSTEM
  INTERNSHIP_PAYMENT_CONFIRMED
  INTERNSHIP_TASK_ASSIGNED
  INTERNSHIP_TASK_REVIEWED
  INTERNSHIP_APPLICATION_ALLOCATED
  INTERNSHIP_APPLICATION_REVIEWED
  INTERNSHIP_PAYOUT_SENT
  CERTIFICATE_ISSUED
}

enum ReputationAction {
  POST_CREATED
  COMMENT_CREATED
  HELPFUL_ANSWER
  REVIEW_CREATED
  RESOURCE_UPLOADED
  RECEIVED_LIKE
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  REVIEW
  RESOURCE
  MESSAGE
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ChatType {
  DIRECT
  GROUP
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  MAGIC_LINK
}

enum EnrollmentStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentTaskStatus {
  ASSIGNED
  SUBMITTED
  APPROVED
  REJECTED
}

enum VirtualInternshipTrack {
  WEEK
  MONTH
}

enum CertificateSourceType {
  TRACK_A_ENROLLMENT
  TRACK_B_APPLICATION
  VIRTUAL_INTERNSHIP
}

// ============================================================
// IDENTITY & AUTH
// ============================================================

model User {
  id           String       @id @default(cuid())
  email        String?      @unique
  phone        String?      @unique
  passwordHash String?
  authProvider AuthProvider @default(EMAIL)
  role         UserRole     @default(STUDENT)
  status       UserStatus   @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // Security / brute force protection
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  // Reputation denormalized for fast leaderboard reads
  reputationPoints Int @default(0)

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  profile            Profile?
  sessions           Session[]
  devices            Device[]
  emailVerifications EmailVerification[]
  otpVerifications   OtpVerification[]
  oauthAccounts      OAuthAccount[]

  resources         Resource[]
  resourceDownloads ResourceDownload[]
  resourceRatings   ResourceRating[]
  resourceBookmarks ResourceBookmark[]
  resourceLikes     ResourceLike[]
  resourceComments  ResourceComment[]

  transfers   Transfer[]
  reviews     Review[]
  reviewVotes ReviewVote[]

  reputationEvents       ReputationEvent[]
  userBadges             UserBadge[]
  notifications          Notification[]    @relation("NotificationRecipient")
  triggeredNotifications Notification[]    @relation("NotificationActor")

  chatParticipants ChatParticipant[]
  messages         Message[]
  complaints       Complaint[]

  reportsMade    Report[]   @relation("Reporter")
  reportsAgainst Report[]   @relation("ReportedUser")
  auditLogs      AuditLog[]

  referralsPosted      Referral[]
  profileLead          ProfileLead?
  referralCode         ReferralCode?

  // Who referred this user in (resolved from a ?ref=<code> link at signup),
  // and the reverse: everyone this user has referred in. Set once, at
  // account creation, never re-assigned.
  referredById                String?
  referredBy                  User?                        @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                   User[]                        @relation("UserReferrals")
  campusAmbassadorApplication CampusAmbassadorApplication?

  certificates                 Certificate[]
  quizAttempts                 QuizAttempt[]
  virtualInternshipEnrollments VirtualInternshipEnrollment[]
  collegeApplications          CollegeApplication[]

  @@index([status])
  @@index([role])
  @@index([reputationPoints(sort: Desc)])
  @@index([createdAt])
  @@index([referredById])
  @@map("users")
}

// One code per unique student going forward — however their account was
// created (email/password, Google, phone OTP, or magic link). Deliberately
// NOT backfilled onto users who registered before this existed. `sequence`
// is a real DB autoincrement (starting at 0) so concurrent signups can never
// collide; `code` is derived from it ("EBN" + the raw number, no padding —
// EBN0, EBN1, EBN2, …) and stored so the list of codes is directly
// queryable. Not exposed via any controller/route yet.
model ReferralCode {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sequence Int     @unique @default(autoincrement())
  // Nullable so two concurrent first-time signups can both insert before
  // either has a formatted code — Postgres allows multiple NULLs under a
  // unique constraint, unlike two rows sharing a placeholder value.
  code     String? @unique

  createdAt DateTime @default(now())

  @@map("referral_codes")
}

enum CampusAmbassadorStatus {
  PENDING
  APPROVED
  REJECTED
}

// One application per student. Whether new applications are accepted at all
// is a simple on/off flag in the generic `Setting` table (key
// "campus_ambassador_applications_open"), not a column here.
model CampusAmbassadorApplication {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Free-form: why the student wants to become a campus ambassador.
  reason String

  status    CampusAmbassadorStatus @default(PENDING)
  createdAt DateTime               @default(now())
  decidedAt DateTime?

  @@index([status])
  @@map("campus_ambassador_applications")
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName  String
  username  String? @unique
  avatarUrl String?
  bio       String?

  collegeId       String?
  college         College?    @relation(fields: [collegeId], references: [id])
  universityId    String?
  university      University? @relation(fields: [universityId], references: [id])
  // Free-text college name from the simplified Internships & Jobs onboarding
  // flow — not tied to the College catalog like collegeId/college above.
  collegeNameText String?

  course String?
  branch String?
  year   Int?
  gender String? // Male | Female | Other | Prefer not to say
  cgpa   Float?
  state  String?
  city   String?

  collegeVerification CollegeVerificationStatus @default(UNVERIFIED)
  signupIntent        SignupIntent? // why they signed up — set once at signup, never re-asked

  interests String[] // tags: Placement, DSA, AI, Startups...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
  @@index([universityId])
  @@index([state, city])
  @@map("profiles")
}

model OAuthAccount {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String
  accessToken    String?
  refreshToken   String?
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  rememberMe       Boolean @default(false)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String?
  platform   String?
  pushToken  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  sessions Session[]

  @@index([userId])
  @@map("devices")
}

model EmailVerification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  purpose   VerificationPurpose @default(EMAIL_VERIFY)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verifications")
}

model OtpVerification {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_verifications")
}

// ============================================================
// COLLEGE DATA LAYER (the moat)
// ============================================================

model University {
  id              String   @id @default(cuid())
  name            String   @unique
  shortName       String?
  state           String?
  city            String?
  type            String? // Private, Central, State, Deemed
  establishedYear Int?
  website         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  colleges College[]
  profiles Profile[]

  @@index([state])
  @@map("universities")
}

model College {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])

  state    String?
  city     String?
  type     String?
  logoUrl  String?
  coverUrl String?
  website  String?
  nirfRank Int?

  // Recommendation-card detail fields (admin-entered)
  accreditation      String?
  admissionPrimary   String?
  admissionSecondary String?
  tuitionFeePerYear  Int?
  verified           Boolean @default(false)
  hasScholarship     Boolean @default(false)

  // ---------- Fixed college info (same regardless of course selected) ----------

  // 1. College Profile
  aboutCollege      String?
  establishmentYear Int?
  ownership         String?
  affiliation       String?
  campusSize        String?
  contactDetails    String?
  brochureUrl       String?

  // 2. Location
  address              String?
  googleMapsUrl        String?
  nearbyMetro          String?
  nearbyRailwayStation String?
  nearbyAirport        String?
  nearbyRestaurants    String?
  nearbyHospitals      String?
  nearbyShoppingAreas  String?
  costOfLiving         String?

  // 3. Rankings (nirfRank above; these are the rest)
  qsRank         Int?
  naacGrade      String?
  nbaStatus      String?
  indiaTodayRank Int?
  outlookRank    Int?
  theWeekRank    Int?

  // 4. Infrastructure
  hasLibrary         Boolean @default(false)
  hasLabs            Boolean @default(false)
  hasSmartClassrooms Boolean @default(false)
  hasSportsComplex   Boolean @default(false)
  hasAuditorium      Boolean @default(false)
  hasCafeteria       Boolean @default(false)
  hasMedicalCentre   Boolean @default(false)
  hasBankAtm         Boolean @default(false)
  hasWifi            Boolean @default(false)
  hasSecurity        Boolean @default(false)

  // 5. Hostel
  hostelAvailable    Boolean @default(false)
  boysHostel         Boolean @default(false)
  girlsHostel        Boolean @default(false)
  hostelFoodQuality  String?
  hostelLaundry      Boolean @default(false)
  hostelHousekeeping Boolean @default(false)
  hostelCurfew       String?
  hostelSecurity     String?
  hostelRules        String?
  nearbyPG           String?
  nearbyFlats        String?

  // 6. Student Life
  clubs          String?
  societies      String?
  technicalClubs String?
  culturalClubs  String?
  annualFest     String?
  sports         String?
  ncc            Boolean @default(false)
  nss            Boolean @default(false)
  studentEvents  String?

  // 7. College Culture
  attendancePolicy String?
  academicPressure String?
  codingCulture    String?
  startupCulture   String?
  researchCulture  String?
  diversity        String?
  campusSafety     String?
  antiRagging      String?
  studentSupport   String?

  // Aggregated metrics (denormalized for fast reads)
  avgPlacementPackage Float?
  reviewCount         Int    @default(0)
  avgRating           Float  @default(0)

  // Ingestion provenance
  sourceSystem String? // JoSAA, CSAB, UPTAC, manual
  externalId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles             Profile[]
  reviews              Review[]
  cutoffs              CollegeCutoff[]
  transfersFrom        Transfer[]            @relation("TransferFromCollege")
  transfersTo          Transfer[]            @relation("TransferToCollege")
  transferRequirements TransferRequirement[]
  resources            Resource[]
  faqs                 CollegeFaq[]
  courses              CollegeCourse[]
  applications         CollegeApplication[]

  @@index([state, city])
  @@index([nirfRank])
  @@index([avgRating(sort: Desc)])
  @@index([sourceSystem, externalId])
  @@map("colleges")
}

// A student marking a college as "Applied" (from /colleges/recommended). One
// row per user+college — re-applying is a no-op via the unique constraint.
model CollegeApplication {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, collegeId])
  @@index([collegeId])
  @@map("college_applications")
}

// One row per Field -> Degree -> Specialization path a college offers.
// Everything here changes depending on which course the student selects on
// the college hub page — as opposed to College's fixed fields above, which
// stay the same regardless of course.
model CollegeCourse {
  id        String  @id @default(cuid())
  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  field          String
  degree         String
  specialization String?

  // 1. Admissions
  eligibility      String?
  entranceExam     String?
  cutoff           String?
  admissionProcess String?
  documents        String?
  seatMatrix       String?
  reservation      String?
  counselling      String?
  managementQuota  String?

  // 2. Fees
  tuitionFee             Int?
  registrationFee        Int?
  examFee                Int?
  hostelFee              Int?
  otherCharges           Int?
  totalCost              Int?
  refundPolicy           String?
  emiAvailable           Boolean @default(false)
  educationLoanAvailable Boolean @default(false)

  // 3. Placements
  placementPct        Float?
  avgPackage          Float?
  medianPackage       Float?
  highestPackage      Float?
  branchWisePlacement String?
  internshipPct       Float?
  ppoPct              Float?
  topRecruiters       String?

  // 4. ROI
  totalInvestment Int?
  averageSalary   Float?
  expectedRoi     String?
  breakEvenTime   String?

  // 5. Opportunities
  scholarshipsInfo String?
  internshipsInfo  String?
  hackathons       String?
  researchProjects String?
  exchangeProgram  String?
  startupCell      String?
  incubation       String?

  // 6. Career Opportunities
  jobRoles         String?
  governmentJobs   String?
  higherStudies    String?
  certifications   String?
  studyAbroad      String?
  entrepreneurship String?

  // 7. Reviews (curated aggregate for this course — distinct from the
  // sitewide Review model, which is per-college not per-course)
  facultyRating        Float?
  placementRating      Float?
  courseRating         Float?
  curriculumRating     Float?
  verifiedReviewsCount Int?

  // 8. Course-specific Q&A — array of { question, answer }
  qna Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
  @@map("college_courses")
}

// Covers internships plus the other opportunity kinds the "Open Career
// Program" surfaces (part-time work, freelance gigs, blogging, startup
// projects) — one broad catalog rather than a separate model per kind.
enum OpportunityType {
  INTERNSHIP
  PART_TIME
  FREELANCE
  BLOGGING
  STARTUP
}

// A browsable internship catalog entry (admin-curated listing) — external
// postings, not applications to an internal program.
model InternshipListing {
  id       String          @id @default(cuid())
  title    String
  slug     String          @unique
  company  String
  location String
  isRemote Boolean         @default(false)
  type     OpportunityType @default(INTERNSHIP)

  stipend  Int? // monthly, INR; null = unpaid
  duration String // e.g. "3 months"

  category    String // e.g. "Engineering", "Design", "Marketing"
  description String
  applyUrl    String
  deadline    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([deadline])
  @@index([type])
  @@map("internship_listings")
}

model CollegeCutoff {
  id           String  @id @default(cuid())
  collegeId    String
  college      College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  year         Int
  round        Int?
  branch       String
  category     String // GEN, OBC, SC, ST, EWS
  quota        String? // AI, HS, OS
  openingRank  Int?
  closingRank  Int?
  sourceSystem String? // JoSAA, CSAB, UPTAC

  createdAt DateTime @default(now())

  @@index([collegeId, year])
  @@index([branch, category])
  @@map("college_cutoffs")
}

// ============================================================
// MODULE 2: TRANSFER HUB
// ============================================================

model Transfer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromCollegeId String?
  fromCollege   College? @relation("TransferFromCollege", fields: [fromCollegeId], references: [id])
  toCollegeId   String?
  toCollege     College? @relation("TransferToCollege", fields: [toCollegeId], references: [id])

  currentYear   Int?
  cgpa          Float?
  branch        String?
  status        TransferStatus @default(EXPLORING)
  story         String? // transfer story (optional, shareable)
  isStoryPublic Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([toCollegeId])
  @@index([status])
  @@map("transfers")
}

model TransferRequirement {
  id             String    @id @default(cuid())
  collegeId      String
  college        College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  branch         String?
  minCgpa        Float?
  minYear        Int?
  maxYear        Int?
  creditTransfer Boolean   @default(false)
  deadline       DateTime?
  feeAmount      Float?
  notes          String?
  sourceSystem   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
  @@map("transfer_requirements")
}

// ============================================================
// MODULE 4: COLLEGE REVIEWS
// ============================================================

model Review {
  id         String         @id @default(cuid())
  collegeId  String?
  college    College?       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category   ReviewCategory
  rating     Int // 1-5
  title      String?
  body       String
  isVerified Boolean        @default(false) // only verified college students
  upvotes    Int            @default(0)
  downvotes  Int            @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  votes ReviewVote[]

  @@unique([collegeId, authorId, category])
  @@index([collegeId, category])
  @@index([upvotes(sort: Desc)])
  @@map("reviews")
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int // 1 or -1
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_votes")
}

// ============================================================
// MODULE 5: RESOURCE HUB
// ============================================================

model Resource {
  id          String       @id @default(cuid())
  uploaderId  String
  uploader    User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  type        ResourceType
  title       String
  description String?
  externalUrl String? // Google Drive / external link (preferred)
  fileKey     String? // S3 key (legacy file uploads)
  fileSize    Int?
  mimeType    String?
  tags        String[]
  collegeTag  String?
  courseTag   String?
  collegeId   String?
  college     College?     @relation(fields: [collegeId], references: [id])
  isFeatured  Boolean      @default(false)

  downloadCount Int   @default(0)
  avgRating     Float @default(0)
  ratingCount   Int   @default(0)
  likeCount     Int   @default(0)
  commentCount  Int   @default(0)
  shareCount    Int   @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  downloads ResourceDownload[]
  ratings   ResourceRating[]
  bookmarks ResourceBookmark[]
  likes     ResourceLike[]
  comments  ResourceComment[]

  @@index([type])
  @@index([tags])
  @@index([avgRating(sort: Desc)])
  @@index([collegeId])
  @@map("resources")
}

model ResourceLike {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([resourceId, userId])
  @@index([userId])
  @@map("resource_likes")
}

model ResourceComment {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())

  @@index([resourceId, createdAt])
  @@map("resource_comments")
}

model CollegeFaq {
  id          String  @id @default(cuid())
  collegeId   String
  college     College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  order       Int     @default(0)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId, order])
  @@map("college_faqs")
}

model ResourceDownload {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([resourceId])
  @@index([userId])
  @@map("resource_downloads")
}

model ResourceRating {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value      Int // 1-5
  createdAt  DateTime @default(now())

  @@unique([resourceId, userId])
  @@index([resourceId])
  @@map("resource_ratings")
}

model ResourceBookmark {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([resourceId, userId])
  @@index([userId])
  @@map("resource_bookmarks")
}

// ============================================================
// MODULE 6: MESSAGING
// ============================================================

model Chat {
  id            String    @id @default(cuid())
  type          ChatType
  title         String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  participants ChatParticipant[]
  messages     Message[]

  @@index([lastMessageAt(sort: Desc)])
  @@map("chats")
}

// Perk: career referral opportunities, open to every user.
model Referral {
  id          String   @id @default(cuid())
  role        String
  company     String
  description String?
  link        String?
  postedById  String
  postedBy    User     @relation(fields: [postedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("referrals")
}

// A student's request for 1:1 expert guidance ("Mentors" on the admin dashboard).
model MentorRequest {
  id               String   @id @default(cuid())
  name             String
  phone            String
  email            String?
  course           String? // course interest
  location         String? // preferred location
  marks            String? // marks / percentage
  budget           String?
  category         String? // optional
  preferredCollege String? // optional
  contactMethod    String? // CALL | CHAT
  message          String?
  status           String   @default("NEW") // NEW | CONTACTED | DONE
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@map("mentor_requests")
}

// One "EduBridge Profile" per student, filled across 4 steps. Each step's data is
// stored as JSON so the admin counselor card can swipe through them; completionPct
// advances 25 per finished step. Counselors add a private note and can delete the
// lead (with a reason logged to ProfileLeadDeletion) — which resets the student to
// a fresh form.
model ProfileLead {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String?
  phone         String?
  email         String?
  step1         Json? // welcome: name, dob, purpose, studying
  step2         Json? // contact: email, city, state, pin, phone
  step3         Json? // personalize: courses, cities, mode, degree, hostel, budget
  step4         Json? // academics: board, stream, marks, exams, doc names
  step5         Json? // next steps: quiz, comparePriorities, directApply
  completionPct Int      @default(0)
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([updatedAt])
  @@map("profile_leads")
}

// Audit trail for counselor-deleted profile leads — keeps the reason + a snapshot
// after the live lead is removed from every view.
model ProfileLeadDeletion {
  id        String   @id @default(cuid())
  userId    String
  name      String?
  reason    String
  snapshot  Json?
  deletedBy String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("profile_lead_deletions")
}

// Per-email delivery audit — one row per send attempt (verification, reset, magic
// link, college-verify). Powers the admin "Email Management" view and deliverability
// debugging without leaking the email body.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  kind      String? // VERIFY | RESET | MAGIC_LINK | COLLEGE_VERIFY | OTHER
  status    String // SENT | FAILED | SKIPPED
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("email_logs")
}

model ChatParticipant {
  id         String    @id @default(cuid())
  chatId     String
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([chatId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model Message {
  id          String        @id @default(cuid())
  chatId      String
  chat        Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body        String
  attachments String[]
  status      MessageStatus @default(SENT)
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  @@index([chatId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

// ============================================================
// MODULE 7: REPUTATION & BADGES
// ============================================================

model ReputationEvent {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    ReputationAction
  points    Int
  refType   String? // post, comment, review...
  refId     String?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("reputation_events")
}

model Badge {
  id          String    @id @default(cuid())
  key         String    @unique // contributor, campus_expert...
  name        String
  description String?
  tier        BadgeTier @default(BRONZE)
  iconUrl     String?
  threshold   Int? // points or count needed

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// ============================================================
// MODULE 8: NOTIFICATIONS
// ============================================================

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  title       String
  body        String?
  data        Json? // refType, refId, deeplink
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// ============================================================
// MODULE 9: INTERNSHIP PROGRAM
// ============================================================

model VirtualInternshipEnrollment {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track              VirtualInternshipTrack
  referralApplied    Boolean                @default(false) // free entitlement flag; doesn't affect feeAmount
  donateApplied      Boolean                @default(false) // adds the flat scholarship-donation amount to feeAmount
  scholarshipApplied Boolean                @default(false) // claimed a 100%-off admin-capped scholarship seat — feeAmount is 0, activated without a Razorpay payment
  feeAmount          Decimal                @db.Decimal(10, 2) // INR, snapshot at enroll time (track price + exact GST + optional donation) — decimal so GST isn't rounded to a whole rupee
  status             EnrollmentStatus       @default(PENDING_PAYMENT)
  razorpayOrderId    String?                @unique
  razorpayPaymentId  String?                @unique
  paidAt             DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  tasks VirtualInternshipTask[]

  @@index([userId, status])
  @@map("virtual_internship_enrollments")
}

// Admin-configured "first N students free" cap per track.
model VirtualInternshipScholarship {
  id          String                 @id @default(cuid())
  track       VirtualInternshipTrack @unique
  capacity    Int                    @default(0) // 0 = closed; admin sets "first N students free"
  updatedById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@map("virtual_internship_scholarships")
}

model VirtualInternshipTask {
  id             String                      @id @default(cuid())
  enrollmentId   String
  enrollment     VirtualInternshipEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  taskIndex      Int // 1-4 = static template index in tasks.constants.ts; 5+ = admin-assigned custom task
  title          String? // set only for admin-assigned custom tasks (taskIndex > 4) — curriculum tasks use the static template's title
  description    String? // set only for admin-assigned custom tasks
  status         EnrollmentTaskStatus        @default(ASSIGNED)
  submissionUrl  String?
  submissionNote String?
  submittedAt    DateTime?
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([enrollmentId, taskIndex])
  @@map("virtual_internship_tasks")
}

model Quiz {
  id          String         @id @default(cuid())
  title       String
  description String?
  isPublished Boolean        @default(false)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order         Int
  prompt        String
  options       String[]
  correctOption Int // index into options
  createdAt     DateTime @default(now())

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id             String   @id @default(cuid())
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers        Json // { [questionId]: selectedOptionIndex }
  score          Int // number of correct answers
  totalQuestions Int
  submittedAt    DateTime @default(now())

  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

model Certificate {
  id            String                @id @default(cuid())
  code          String                @unique // e.g. EB-4F7K2QRT
  recipientId   String
  recipient     User                  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientName String // snapshot — survives later profile-name edits
  title         String // server-generated, not admin-free-typed
  sourceType    CertificateSourceType
  sourceId      String // id of the record that earned this certificate (historical: a
  // now-removed TrackAEnrollment/TrackBApplication row, or a VirtualInternshipEnrollment)
  issuedAt DateTime @default(now())
  metadata Json? // rendering details, shape depends on sourceType
  revokedAt     DateTime?

  @@unique([sourceType, sourceId]) // one certificate per enrollment/application
  @@index([recipientId])
  @@map("certificates")
}

// ============================================================
// ADMIN, MODERATION, AUDIT, RBAC
// ============================================================

model Report {
  id             String           @id @default(cuid())
  reporterId     String
  reporter       User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     ReportTargetType
  targetId       String
  reportedUserId String?
  reportedUser   User?            @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reason         String
  details        String?
  status         ReportStatus     @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String // user.ban, community.delete...
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // user.ban, post.remove...
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Complaint {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body         String
  status       String    @default("OPEN") // OPEN | RESOLVED
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@map("complaints")
}
